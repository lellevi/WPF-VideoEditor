<Window x:Class="VideoEditorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Video Editor WPF" Height="800" Width="1400">

    <Window.Resources>
        <Style x:Key="TrackHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="BorderBrush" Value="#FF3E3E42"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FF464646"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DefaultBadgeStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Media Library -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📁 Media Library"
                      Margin="10" FontWeight="Bold" HorizontalAlignment="Center"/>

                <ListBox x:Name="MediaLibraryList" Grid.Row="1"
                     ItemsSource="{Binding MediaFiles}"
                     Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="MediaLibraryList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding ThumbnailPath}" Width="50" Height="40" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding DurationString}" Foreground="Gray" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button x:Name="AddMediaButton" Grid.Row="2" Command="{Binding AddMediaCommand}"
                    Content="➕ Add Files" Height="35" Margin="10" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- MIDDLE: Preview + Timeline -->
        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="400"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Preview -->
            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1">
                <MediaElement x:Name="PreviewMediaElement"
                         LoadedBehavior="Manual" UnloadedBehavior="Stop"
                         Stretch="Uniform"/>
            </Border>

            <!-- Transport Controls -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
                <Button Command="{Binding PreviousFrameCommand}" Content="⏮" Width="45" Height="35" Margin="5"/>
                <Button x:Name="PlayPauseBtn" Command="{Binding PlayPauseCommand}" Content="⏸" Width="45" Height="35" Margin="5"/>
                <Button Command="{Binding NextFrameCommand}" Content="⏭" Width="45" Height="35" Margin="5"/>
                <TextBlock x:Name="CurrentTimeLabel" Text="00:00:00"
                      Margin="25,0 15,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <Slider x:Name="TimelineSlider" Width="250" Height="25" Margin="10,0"
                    Value="{Binding Timeline.PlayheadPosition}"/>
                <TextBlock x:Name="TotalTimeLabel" Text="00:00:00" Margin="10,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Timeline with Track Management -->
            <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Track Controls Toolbar -->
                    <Border Grid.Row="0" Background="#FF252526" BorderBrush="#FF3E3E42" BorderThickness="0,0,0,1" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding Timeline.AddVideoTrackCommand}"
                                    Content="➕ Video" Width="90" Height="28" Margin="5,0"/>
                            <Button Command="{Binding Timeline.AddAudioTrackCommand}"
                                    Content="➕ Audio" Width="90" Height="28" Margin="5,0"/>
                            <Button Command="{Binding Timeline.DeleteSelectedTrackCommand}"
                                    Content="🗑 Delete" Width="90" Height="28" Margin="5,0"
                                    ToolTip="Delete selected track (cannot delete default tracks)"/>

                            <TextBlock VerticalAlignment="Center" Margin="20,0,0,0" Foreground="LightGray">
                                <Run Text="Selected: "/>
                                <Run Text="{Binding Timeline.SelectedTrack.Name, Mode=OneWay}" FontWeight="Bold"/>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Timeline.SelectedTrack}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Timeline Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Track Headers -->
                        <Border Grid.Column="0" Background="#FF2D2D2D" BorderBrush="#FF3E3E42" BorderThickness="0,0,1,0">
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                          x:Name="TrackHeadersScrollViewer">
                                <ItemsControl ItemsSource="{Binding Timeline.Tracks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TrackHeaderStyle}"
                                                    Height="70"
                                                    MouseLeftButtonDown="TrackHeader_MouseLeftButtonDown"
                                                    Tag="{Binding}">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0"
                                                               Text="{Binding Name}"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               FontSize="12"/>

                                                    <StackPanel Grid.Row="1"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <ToggleButton Content="🔇"
                                                                      IsChecked="{Binding IsMuted}"
                                                                      Width="28" Height="24"
                                                                      Margin="2"
                                                                      ToolTip="Mute track"/>
                                                        <ToggleButton Content="🔒"
                                                                      IsChecked="{Binding IsLocked}"
                                                                      Width="28" Height="24"
                                                                      Margin="2"
                                                                      ToolTip="Lock track"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Type}"
                                                                   Foreground="Gray"
                                                                   FontSize="10"/>
                                                        <TextBlock Text=" • Default"
                                                                   Foreground="LightBlue"
                                                                   FontSize="10"
                                                                   Style="{StaticResource DefaultBadgeStyle}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Timeline Canvas -->
                        <ScrollViewer Grid.Column="1" x:Name="TimelineScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Canvas x:Name="TimelineCanvas" Width="4000" Height="400" Background="#FF2D2D2D"
                                    MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"
                                    MouseMove="TimelineCanvas_MouseMove"
                                    MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp"
                                    MouseWheel="TimelineCanvas_MouseWheel">

                                <!-- Time Markers Background -->
                                <Canvas x:Name="TimeMarkersCanvas" Width="4000" Height="30" Canvas.Top="0" IsHitTestVisible="False"/>

                                <!-- Playhead -->
                                <Rectangle x:Name="Playhead" Width="3" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                           Fill="LimeGreen" Canvas.Left="{Binding Timeline.PlayheadPosition}"/>

                            </Canvas>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- Zoom -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
                <TextBlock Text="🔍 Zoom:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="ZoomSlider" Width="150" Height="25"
                   Value="{Binding Timeline.TimelineScale}"/>
                <TextBlock x:Name="ZoomLabel" Text="{Binding Timeline.TimelineScale, StringFormat={}{0:F1}x}"
                      Margin="15,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- RIGHT: Properties -->
        <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Margin="5">
            <StackPanel Margin="15">
                <TextBlock Text="⚙️ Properties" FontWeight="Bold" FontSize="16" Margin="0,0,0,20"/>

                <TextBlock x:Name="SelectedClipLabel" Text="No clip selected"
                      FontWeight="SemiBold" Margin="0,0,0,15"/>

                <TextBlock Text="⏱️ Start:" Margin="0,0,0,5"/>
                <Slider x:Name="ClipStartSlider" Height="25" Margin="0,0,0,15"/>

                <TextBlock Text="⏳ Duration:" Margin="0,0,0,5"/>
                <Slider x:Name="ClipDurationSlider" Height="25" Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <CheckBox x:Name="MuteCheckBox" Content="🔇 Mute" Margin="0,0,15,0"/>
                    <TextBlock Text="🔊 Volume:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="VolumeSlider" Width="120" Height="25"/>
                </StackPanel>

                <Button x:Name="ExportButton" Command="{Binding ExportCommand}" Content="💾 Export Video"
                   Height="50" Background="DodgerBlue" Foreground="White"
                   FontWeight="Bold" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>