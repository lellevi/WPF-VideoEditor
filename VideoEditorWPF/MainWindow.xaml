<Window x:Class="VideoEditorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Video Editor WPF" Height="800" Width="1400">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Media Library" FontWeight="Bold" Margin="10"/>
                <StackPanel Grid.Row="1" Margin="10">
                    <Button Content="Import Video" Command="{Binding ImportVideoCommand}"/>
                    <ListBox ItemsSource="{Binding MediaFiles}"
                             SelectedItem="{Binding SelectedMediaFile}"
                             Height="400"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="400"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="{Binding PreviewImage}" Stretch="Uniform"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTime, StringFormat='Time: {0:hh\\:mm\\:ss}'}" Margin="10,0"/>
                        <ProgressBar Value="{Binding PreviewPosition}" Maximum="100" Width="200" Height="20"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Canvas Background="Black" Height="150" Width="{Binding TimelineWidth}">
                        <Rectangle Width="2" Height="150" Fill="Red"
                                   Canvas.Left="{Binding PlayheadPosition}">
                            <Rectangle.RenderTransform>
                                <TranslateTransform X="{Binding PlayheadPosition}"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <ItemsControl ItemsSource="{Binding TimelineClips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Width="{Binding Width}" Height="80"
                                               Fill="SteelBlue" Stroke="White" StrokeThickness="2"
                                               Canvas.Left="{Binding LeftPosition}"
                                               Canvas.Top="10">
                                        <Rectangle.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}"/>
                                                <TextBlock Text="{Binding Duration, StringFormat='Duration: {0:hh\\:mm\\:ss}'}"/>
                                            </StackPanel>
                                        </Rectangle.ToolTip>
                                    </Rectangle>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="⏮" Command="{Binding PreviousFrameCommand}" FontSize="20"/>
                <Button Content="⏸" Command="{Binding PlayPauseCommand}" FontSize="20"/>
                <Button Content="⏭" Command="{Binding NextFrameCommand}" FontSize="20"/>
                <Button Content="Trim Clip" Command="{Binding TrimClipCommand}"/>
                <Button Content="Add to Timeline" Command="{Binding AddToTimelineCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Margin="10">

                    <TextBlock Text="{Binding SelectedMediaFile.FileName}" FontWeight="Bold"
                       FontSize="14" Margin="0,0,0,15" TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding VideoDuration}" FontWeight="Bold" FontSize="18"
                       Margin="0,0,0,20" HorizontalAlignment="Center" Foreground="SteelBlue"/>

                    <Border BorderBrush="Gray" BorderThickness="2" CornerRadius="10" Margin="0,0,0,15">
                        <Grid Height="60">
                            <Rectangle Fill="#333" RadiusX="8" RadiusY="8"/>

                            <Rectangle Fill="DodgerBlue" Opacity="0.7"
                               Width="{Binding TrimmedWidth}"
                               HorizontalAlignment="Left"
                               Height="60" RadiusX="8" RadiusY="8"/>

                            <TextBlock Text="{Binding TrimStartText}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Margin="15,0" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding TrimEndText}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="15,0" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding TrimDuration}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" FontWeight="Bold" Foreground="Gold"/>
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="⏮ Начало обрезки" FontWeight="Bold" FontSize="12"/>
                        <Slider Value="{Binding TrimStart}"
                        Minimum="0"
                        Maximum="{Binding SelectedMediaFile.Duration}"
                        Width="280" Height="35"
                        Background="LightGray"
                        Foreground="Orange"/>
                        <TextBox Text="{Binding TrimStart, StringFormat={}{0:F1}}"
                         Width="50" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="⏭ Конец обрезки" FontWeight="Bold" FontSize="12"/>
                        <Slider Value="{Binding TrimEnd}"
                        Minimum="{Binding TrimStart}"
                        Maximum="{Binding SelectedMediaFile.Duration}"
                        Width="280" Height="35"
                        Background="LightGray"
                        Foreground="LimeGreen"/>
                        <TextBox Text="{Binding TrimEnd, StringFormat={}{0:F1}}"
                         Width="50" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Button Content="Применить обрезку" Command="{Binding TrimClipCommand}"
                        Background="DodgerBlue" Foreground="White" FontWeight="Bold"
                        Margin="0,0,0,5" Padding="15,8"/>
                        <Button Content="Добавить на Timeline" Command="{Binding AddToTimelineCommand}"
                        Background="ForestGreen" Foreground="White" FontWeight="Bold"
                        Padding="15,8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="15" Orientation="Vertical">
                    <Button Content="Экспорт видео" Command="{Binding ExportCommand}"
                    Background="DarkRed" Foreground="White" FontWeight="Bold" FontSize="14"
                    Padding="20,12" Margin="0,0,0,10"/>
                    <ProgressBar Value="{Binding ExportProgress}" Height="25"/>
                    <TextBlock Text="{Binding ExportStatus}" TextWrapping="Wrap"
                       Margin="0,5" FontSize="12" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
