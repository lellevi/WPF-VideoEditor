    <!-- Delete Track Button Style -->
    <Style x:Key="DeleteTrackButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FF555555"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#FF777777"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFAA4444"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FF883333"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>