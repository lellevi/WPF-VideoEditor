<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Track Header Style -->
    <Style x:Key="TrackHeaderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="#FF3E3E42"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="#FF2D2D2D"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Type}" Value="Video">
                <Setter Property="Background" Value="#FF2A4A5A"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="Audio">
                <Setter Property="Background" Value="#FF4A3A2A"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                    <Condition Binding="{Binding Type}" Value="Video"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#FF3A6A7A"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                    <Condition Binding="{Binding Type}" Value="Audio"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#FF6A5A4A"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Default Badge Style -->
    <Style x:Key="DefaultBadgeStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Track Mute/Lock Toggle Button Style -->
    <Style x:Key="TrackToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="#FFAA4444"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="BorderBrush" Value="#FFCC5555"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="White"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#FFCC5555"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>